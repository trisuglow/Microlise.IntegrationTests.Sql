<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageOutputPath>D:\LocalNuGetPackages\</PackageOutputPath>
	  <RootNamespace>Microlise.IntegrationTests.Sql</RootNamespace>
	  <!-- VSTest loads adapters named *TestAdapter.dll from the test output directory. -->
	  <AssemblyName>Microlise.IntegrationTests.Sql.TestAdapter</AssemblyName>
	  <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <IsPackable>true</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Title>Microlise Integration Tests Library (SQL)</Title>
    <Company>Microlise</Company>
    <Version>0.0.14</Version>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Template.Integration.Tests\appsettings.json" Link="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
  </ItemGroup>

</Project>
